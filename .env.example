# Beispielkonfiguration fuer lokale Werte.
#
# Diese Datei ist ein TEMPLAT — echte Werte gehoeren in `.env`
# (gitignored). Es werden hier **keine** Geheimnisse gespeichert.
#
# Kopieren:  cp .env.example .env

# Pfad zur Antigravity-CLI. Leer lassen = automatische Erkennung
# (bevorzugt ~/.gemini/bin/agy, das --print/--output-format/--json-schema kennt).
AGY_BIN=

# Browser fuer yt-dlp --cookies-from-browser (nur der NAME, keine Cookies).
# Werte: chrome, firefox, brave, edge, safari, opera
YT_COOKIES_FROM_BROWSER=chrome

# Optional: Zielkanal-Profil (shorts, longform). Leer = Standard aus pipeline.yaml.
MEDIA_PIPELINE_CHANNEL=
